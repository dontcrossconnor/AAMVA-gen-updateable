{
  "name": "aamva-pdf417-generator",
  "productName": "AAMVA PDF417 Studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:start": "electron .",
    "dist": "npm run build && electron-builder --win portable dir"
  },
  "build": {
    "appId": "com.aamva.pdf417generator",
    "productName": "AAMVA PDF417 Studio",
    "executableName": "AAMVAPDF417Studio",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs"
    ],
    "win": {
      "target": [
        "portable",
        "dir"
      ]
    }
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "bwip-js": "^4.11.2",
    "lucide": "^1.28.0",
    "puppeteer": "^25.5.0"
  }
}
